AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_UPLOAD_ENDPOINT=http://localhost:4566
LOCALSTACK_DEBUG=0

DOCUMENT_UPLOAD_BUCKET=rag-platform-document-uploads-local

OUTBOX_PUBLISHER_POLL_SECONDS=2
OUTBOX_CLAIM_LEASE_SECONDS=60
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=300
INGESTION_WORKER_HMAC_PRIMARY_KEY_ID=local-v1
INGESTION_WORKER_HMAC_PRIMARY_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
INGESTION_WORKER_HMAC_SECONDARY_KEY_ID=
INGESTION_WORKER_HMAC_SECONDARY_SECRET=
INGESTION_WORKER_HMAC_MAX_CLOCK_SKEW_SECONDS=300
INGESTION_PROCESSING_LEASE_SECONDS=120
INGESTION_CHUNK_BATCH_SIZE=50
INGESTION_CHUNK_BODY_BYTES=1048576
INGESTION_RESUME_PAGE_SIZE=50

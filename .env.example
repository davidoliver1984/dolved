# Required only when the real Voyage embedding adapter is instantiated.
VOYAGE_API_KEY=
VOYAGE_API_URL=https://api.voyageai.com/v1/embeddings
EMBEDDING_MODEL=voyage-4-large
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=10
EMBEDDING_MAX_ATTEMPTS=3
EMBEDDING_INITIAL_BACKOFF_SECONDS=0.25
EMBEDDING_MAX_BACKOFF_SECONDS=2
EMBEDDING_ESTIMATED_COST_PER_MILLION_TOKENS_USD=0.12
QDRANT_URL=http://qdrant:6333

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TIMEOUT=250
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.dolved.internal/http/ingestion-worker/v1/ingestion-extraction-artifact-authorise-request-v1.schema.json",
  "title": "Extraction Artifact Upload Authorise Request (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "event_id", "workspace_id", "document_id", "lease_token", "lease_generation"],
  "properties": {
    "contract_version": { "const": 1 },
    "event_id": { "type": "string", "format": "uuid" },
    "workspace_id": { "type": "string", "format": "uuid" },
    "document_id": { "type": "string", "format": "uuid" },
    "lease_token": { "type": "string", "format": "uuid" },
    "lease_generation": { "type": "integer", "minimum": 1 }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "event_id",
    "workspace_id",
    "document_id",
    "lease_token",
    "expected_chunk_count",
    "chunk_manifest_digest",
    "point_manifest_digest",
    "expected_point_count",
    "point_ids",
    "embedding_profile_fingerprint",
    "embedding_space_generation_id",
    "workspace_corpus_generation_id",
    "publication_verified"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "lease_token": {
      "type": "string",
      "format": "uuid"
    },
    "expected_chunk_count": {
      "type": "integer",
      "minimum": 1
    },
    "chunk_manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "point_manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_point_count": {
      "type": "integer",
      "minimum": 1
    },
    "point_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "embedding_profile_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sparse_profile_fingerprint": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "embedding_space_generation_id": {
      "type": "string",
      "format": "uuid"
    },
    "sparse_space_generation_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "uuid"
        }
      ]
    },
    "workspace_corpus_generation_id": {
      "type": "string",
      "format": "uuid"
    },
    "warnings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9._-]+$",
            "maxLength": 100
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "publication_verified": {
      "const": true
    },
    "usage": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "provider",
          "model",
          "execution",
          "request_count",
          "retry_count",
          "input_tokens",
          "cached_input_tokens",
          "output_tokens",
          "latency_ms",
          "cost_usd",
          "cost_basis",
          "pricing_snapshot"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "execution": {
            "enum": [
              "provider_api",
              "local"
            ]
          },
          "request_count": {
            "type": "integer",
            "minimum": 0
          },
          "retry_count": {
            "type": "integer",
            "minimum": 0
          },
          "input_tokens": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          },
          "cached_input_tokens": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          },
          "output_tokens": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          },
          "latency_ms": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "number",
                "minimum": 0
              }
            ]
          },
          "cost_usd": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "number",
                "minimum": 0
              }
            ]
          },
          "cost_basis": {
            "enum": [
              "provider_reported",
              "estimated",
              "unavailable",
              "zero_cost_local"
            ]
          },
          "pricing_snapshot": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "maxLength": 255
              }
            ]
          }
        }
      }
    }
  },
  "$id": "https://contracts.dolved.internal/http/ingestion-worker/v1/ingestion-complete-request-v1.schema.json",
  "title": "Ingestion Complete Request (v1)"
}

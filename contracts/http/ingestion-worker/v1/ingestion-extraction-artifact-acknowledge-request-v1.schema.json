{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.dolved.internal/http/ingestion-worker/v1/ingestion-extraction-artifact-acknowledge-request-v1.schema.json",
  "title": "Extraction Artifact Acknowledge Request (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "event_id", "workspace_id", "document_id", "lease_token", "lease_generation", "authorisation_id", "artifact_contract_version", "artifact_sha256", "size_bytes", "projection_manifest_digest", "warning_manifest_digest", "element_count", "warning_count"],
  "properties": {
    "contract_version": { "const": 1 },
    "event_id": { "type": "string", "format": "uuid" },
    "workspace_id": { "type": "string", "format": "uuid" },
    "document_id": { "type": "string", "format": "uuid" },
    "lease_token": { "type": "string", "format": "uuid" },
    "lease_generation": { "type": "integer", "minimum": 1 },
    "authorisation_id": { "type": "string", "format": "uuid" },
    "artifact_contract_version": { "const": "document-extraction-artifact-v1" },
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "size_bytes": { "type": "integer", "minimum": 1 },
    "projection_manifest_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "warning_manifest_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "element_count": { "type": "integer", "minimum": 0 },
    "warning_count": { "type": "integer", "minimum": 0 },
    "storage_version_id": { "type": ["string", "null"], "minLength": 1 },
    "storage_etag": { "type": ["string", "null"], "minLength": 1 }
  }
}

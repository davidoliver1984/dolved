{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "workspace_id",
    "document_id",
    "storage_bucket",
    "storage_key",
    "media_type",
    "byte_size",
    "correlation_id"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "document.ingestion.requested"
    },
    "event_version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "storage_bucket": {
      "type": "string",
      "minLength": 1
    },
    "storage_key": {
      "type": "string",
      "minLength": 1
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "byte_size": {
      "type": "integer",
      "minimum": 1
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "$id": "https://contracts.dolved.internal/http/ingestion-worker/v1/ingestion-claim-request-v1.schema.json",
  "title": "Ingestion Claim Request (v1)"
}

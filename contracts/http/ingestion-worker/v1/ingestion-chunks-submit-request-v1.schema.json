{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "event_id",
    "workspace_id",
    "document_id",
    "lease_token",
    "chunks"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "lease_token": {
      "type": "string",
      "format": "uuid"
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chunk_id",
          "ordinal",
          "text",
          "token_count",
          "strategy_name",
          "strategy_version",
          "configuration",
          "configuration_fingerprint",
          "provenance",
          "content_digest"
        ],
        "properties": {
          "chunk_id": {
            "type": "string",
            "format": "uuid"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "token_count": {
            "type": "integer",
            "minimum": 1
          },
          "strategy_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "strategy_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "configuration": {
            "type": "object"
          },
          "configuration_fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "normalised_element_id",
                "source_element_ids",
                "source_locations",
                "element_start_character",
                "element_end_character",
                "chunk_start_character",
                "chunk_end_character",
                "role"
              ],
              "properties": {
                "normalised_element_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "source_element_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "source_locations": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "oneOf": [
                      {
                        "$schema": "https://json-schema.org/draft/2020-12/schema",
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "start_character",
                          "end_character",
                          "start_line",
                          "end_line"
                        ],
                        "properties": {
                          "kind": {
                            "const": "text"
                          },
                          "start_character": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "end_character": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "start_line": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "end_line": {
                            "type": "integer",
                            "minimum": 1
                          }
                        }
                      },
                      {
                        "$schema": "https://json-schema.org/draft/2020-12/schema",
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "page_number",
                          "page_width",
                          "page_height",
                          "x0",
                          "top",
                          "x1",
                          "bottom",
                          "rotation_degrees",
                          "has_distinct_crop_box"
                        ],
                        "properties": {
                          "kind": {
                            "const": "pdf"
                          },
                          "page_number": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "page_width": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "page_height": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "x0": {
                            "type": "number"
                          },
                          "top": {
                            "type": "number"
                          },
                          "x1": {
                            "type": "number"
                          },
                          "bottom": {
                            "type": "number"
                          },
                          "rotation_degrees": {
                            "enum": [
                              0,
                              90,
                              180,
                              270
                            ]
                          },
                          "has_distinct_crop_box": {
                            "type": "boolean"
                          },
                          "start_character": {
                            "oneOf": [
                              {
                                "type": "null"
                              },
                              {
                                "type": "integer",
                                "minimum": 0
                              }
                            ]
                          },
                          "end_character": {
                            "oneOf": [
                              {
                                "type": "null"
                              },
                              {
                                "type": "integer",
                                "minimum": 0
                              }
                            ]
                          }
                        }
                      },
                      {
                        "$schema": "https://json-schema.org/draft/2020-12/schema",
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "body_block_index"
                        ],
                        "properties": {
                          "kind": {
                            "const": "docx"
                          },
                          "body_block_index": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "table_row_index": {
                            "oneOf": [
                              {
                                "type": "null"
                              },
                              {
                                "type": "integer",
                                "minimum": 0
                              }
                            ]
                          },
                          "table_column_index": {
                            "oneOf": [
                              {
                                "type": "null"
                              },
                              {
                                "type": "integer",
                                "minimum": 0
                              }
                            ]
                          },
                          "start_character": {
                            "oneOf": [
                              {
                                "type": "null"
                              },
                              {
                                "type": "integer",
                                "minimum": 0
                              }
                            ]
                          },
                          "end_character": {
                            "oneOf": [
                              {
                                "type": "null"
                              },
                              {
                                "type": "integer",
                                "minimum": 0
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                },
                "element_start_character": {
                  "type": "integer",
                  "minimum": 0
                },
                "element_end_character": {
                  "type": "integer",
                  "minimum": 1
                },
                "chunk_start_character": {
                  "type": "integer",
                  "minimum": 0
                },
                "chunk_end_character": {
                  "type": "integer",
                  "minimum": 1
                },
                "role": {
                  "enum": [
                    "primary",
                    "overlap"
                  ]
                }
              }
            }
          },
          "content_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "$id": "https://contracts.dolved.internal/http/ingestion-worker/v1/ingestion-chunks-submit-request-v1.schema.json",
  "title": "Ingestion Chunks Submit Request (v1)"
}

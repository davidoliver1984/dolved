{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data"
  ],
  "properties": {
    "data": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "evidence"
      ],
      "properties": {
        "outcome": {
          "const": "authorised"
        },
        "evidence": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected_chunk_count",
            "chunk_manifest_digest",
            "point_manifest_digest",
            "expected_point_count",
            "point_ids",
            "embedding_profile_fingerprint",
            "embedding_space_generation_id",
            "workspace_corpus_generation_id"
          ],
          "properties": {
            "expected_chunk_count": {
              "type": "integer",
              "minimum": 1
            },
            "chunk_manifest_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "point_manifest_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "expected_point_count": {
              "type": "integer",
              "minimum": 1
            },
            "point_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "embedding_profile_fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "sparse_profile_fingerprint": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              ]
            },
            "embedding_space_generation_id": {
              "type": "string",
              "format": "uuid"
            },
            "sparse_space_generation_id": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "format": "uuid"
                }
              ]
            },
            "workspace_corpus_generation_id": {
              "type": "string",
              "format": "uuid"
            },
            "warnings": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "pattern": "^[a-z0-9._-]+$",
                    "maxLength": 100
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$id": "https://contracts.dolved.internal/http/ingestion-worker/v1/ingestion-publication-authorise-response-v1.schema.json",
  "title": "Ingestion Publication Authorise Response (v1)"
}

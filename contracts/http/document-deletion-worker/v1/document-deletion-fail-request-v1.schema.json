{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "event_id",
    "workspace_id",
    "document_id",
    "lease_token",
    "classification",
    "failure_code",
    "failure_message"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "lease_token": {
      "type": "string",
      "format": "uuid"
    },
    "classification": {
      "enum": [
        "retryable",
        "permanent"
      ]
    },
    "failure_code": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+$",
      "maxLength": 100
    },
    "failure_message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  },
  "$id": "https://contracts.dolved.internal/http/document-deletion-worker/v1/document-deletion-fail-request-v1.schema.json",
  "title": "Document Deletion Fail Request (v1)"
}

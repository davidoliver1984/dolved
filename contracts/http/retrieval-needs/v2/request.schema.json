{
  "$defs": {
    "CatalogueFamily": {
      "additionalProperties": false,
      "properties": {
        "family_id": {
          "format": "uuid",
          "title": "Family Id",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "family_id",
        "title"
      ],
      "title": "CatalogueFamily",
      "type": "object"
    },
    "UserTurn": {
      "additionalProperties": false,
      "properties": {
        "turn_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Turn Id",
          "type": "string"
        },
        "text": {
          "maxLength": 8000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "turn_id",
        "text"
      ],
      "title": "UserTurn",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": 2,
      "title": "Contract Version",
      "type": "integer"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "user_turns": {
      "items": {
        "$ref": "#/$defs/UserTurn"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "User Turns",
      "type": "array"
    },
    "catalogue": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CatalogueFamily"
      },
      "maxItems": 500,
      "title": "Catalogue",
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "request_id",
    "workspace_id",
    "evaluated_at",
    "user_turns"
  ],
  "title": "NeedsPlanRequest",
  "type": "object"
}

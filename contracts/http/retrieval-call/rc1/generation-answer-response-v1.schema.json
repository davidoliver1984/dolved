{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maketime.ai/contracts/http/retrieval-call/rc1/generation-answer-response-v1.schema.json",
  "title": "Grounded generation response envelope",
  "oneOf": [
    {"$ref": "#/$defs/completed"},
    {"$ref": "#/$defs/contextBudgetExceeded"},
    {"$ref": "#/$defs/providerError"}
  ],
  "$defs": {
    "answerPart": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "evidence_ids"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^ev-[0-9]{2,}$"}}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "outcome", "answer_parts", "unsupported_aspects", "insufficiency_reason", "usage"],
      "properties": {
        "contract_version": {"const": 1},
        "outcome": {"enum": ["answered", "qualified", "insufficient_evidence"]},
        "answer_parts": {"type": "array", "items": {"$ref": "#/$defs/answerPart"}},
        "unsupported_aspects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
        "insufficiency_reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 8000, "pattern": "\\S"},
        "usage": {"type": ["object", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"outcome": {"const": "answered"}}},
          "then": {
            "properties": {
              "answer_parts": {"minItems": 1},
              "unsupported_aspects": {"maxItems": 0},
              "insufficiency_reason": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"outcome": {"const": "qualified"}}},
          "then": {
            "properties": {
              "answer_parts": {"minItems": 1},
              "unsupported_aspects": {"minItems": 1},
              "insufficiency_reason": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"outcome": {"const": "insufficient_evidence"}}},
          "then": {
            "properties": {
              "answer_parts": {"maxItems": 0},
              "unsupported_aspects": {"minItems": 1},
              "insufficiency_reason": {"type": "string", "minLength": 1, "maxLength": 8000, "pattern": "\\S"}
            }
          }
        }
      ]
    },
    "completed": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "request_id", "status", "result"],
      "properties": {
        "contract_version": {"const": 1}, "request_id": {"type": "string", "format": "uuid"},
        "status": {"const": "completed"}, "result": {"$ref": "#/$defs/result"}
      }
    },
    "contextBudgetExceeded": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "request_id", "status", "failure"],
      "properties": {
        "contract_version": {"const": 1}, "request_id": {"type": "string", "format": "uuid"},
        "status": {"const": "context_budget_exceeded"},
        "failure": {
          "type": "object", "additionalProperties": false,
          "required": ["code", "policy_version", "proposed_units", "maximum_units"],
          "properties": {
            "code": {"const": "GENERATION_CONTEXT_BUDGET_EXCEEDED"},
            "policy_version": {"type": "string", "minLength": 1},
            "proposed_units": {"type": "integer", "minimum": 0},
            "maximum_units": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "providerError": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "request_id", "status", "error"],
      "properties": {
        "contract_version": {"const": 1}, "request_id": {"type": "string", "format": "uuid"},
        "status": {"const": "provider_error"},
        "error": {
          "type": "object", "additionalProperties": false,
          "required": ["category", "provider", "model", "http_status", "attempt_count", "latency_ms"],
          "properties": {
            "category": {"enum": ["transport_failure", "rate_limit", "timeout", "malformed_typed_output", "provider_refusal", "contract_validation_failure"]},
            "provider": {"type": ["string", "null"]}, "model": {"type": ["string", "null"]},
            "http_status": {"type": ["integer", "null"]}, "attempt_count": {"type": "integer", "minimum": 1},
            "latency_ms": {"type": "number", "minimum": 0}
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maketime.ai/contracts/http/retrieval-call/rc1/rerank-v1.schema.json",
  "title": "Eligible candidate reranking request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "workspace_id", "query", "profile", "candidates", "top_k"],
  "properties": {
    "contract_version": {"const": 1},
    "request_id": {"type": "string", "format": "uuid"},
    "workspace_id": {"type": "string", "format": "uuid"},
    "query": {"type": "string", "minLength": 1, "maxLength": 8000},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "adapter_version", "truncation"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1},
        "truncation": {"const": false}
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chunk_id", "document_id", "document_family_id", "version_position", "side", "text", "fused_score", "fused_rank"],
        "properties": {
          "chunk_id": {"type": "string", "format": "uuid"},
          "document_id": {"type": "string", "format": "uuid"},
          "document_family_id": {"type": "string", "format": "uuid"},
          "version_position": {"type": ["integer", "null"], "minimum": 1},
          "side": {"enum": ["primary", "comparison"]},
          "text": {"type": "string", "minLength": 1},
          "fused_score": {"type": "number"},
          "fused_rank": {"type": "integer", "minimum": 1}
        }
      }
    },
    "top_k": {"type": "integer", "minimum": 1, "maximum": 100}
  }
}

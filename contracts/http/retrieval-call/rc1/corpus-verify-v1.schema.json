{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maketime.ai/contracts/http/retrieval-call/rc1/corpus-verify-v1.schema.json",
  "title": "Corpus completeness verification request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "workspace_id", "vector_space", "workspace_corpus_generation_id", "points"],
  "properties": {
    "contract_version": { "const": 1 },
    "request_id": { "type": "string", "format": "uuid" },
    "workspace_id": { "type": "string", "format": "uuid" },
    "workspace_corpus_generation_id": { "type": "string", "format": "uuid" },
    "vector_space": { "type": "object" },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chunk_id", "document_id", "event_id"],
        "properties": {
          "chunk_id": { "type": "string", "format": "uuid" },
          "document_id": { "type": "string", "format": "uuid" },
          "event_id": { "type": "string", "format": "uuid" }
        }
      }
    }
  }
}

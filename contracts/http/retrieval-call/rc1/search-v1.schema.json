{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maketime.ai/contracts/http/retrieval-call/rc1/search-v1.schema.json",
  "title": "Scoped semantic search request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "workspace_id", "query", "embedding_profile", "embedding_profile_fingerprint", "vector_space", "workspace_corpus_generation_id", "candidate_k", "scopes"],
  "properties": {
    "contract_version": {"const": 1},
    "request_id": {"type": "string", "format": "uuid"},
    "workspace_id": {"type": "string", "format": "uuid"},
    "query": {"type": "string", "minLength": 1, "maxLength": 8000},
    "embedding_profile": {"type": "object"},
    "embedding_profile_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vector_space": {"type": "object"},
    "workspace_corpus_generation_id": {"type": "string", "format": "uuid"},
    "candidate_k": {"type": "integer", "minimum": 1, "maximum": 100},
    "scopes": {
      "type": "array", "minItems": 1, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["side", "eligible_document_ids"],
        "properties": {
          "side": {"enum": ["primary", "comparison"]},
          "eligible_document_ids": {
            "type": "array", "minItems": 1, "maxItems": 500,
            "uniqueItems": true, "items": {"type": "string", "format": "uuid"}
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maketime.ai/contracts/http/retrieval-call/rc1/search-v1.schema.json",
  "title": "Scoped semantic search request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "workspace_id", "query", "embedding_profile", "embedding_profile_fingerprint", "vector_space", "workspace_corpus_generation_id", "candidate_k", "scopes"],
  "properties": {
    "contract_version": {"const": 1},
    "request_id": {"type": "string", "format": "uuid"},
    "workspace_id": {"type": "string", "format": "uuid"},
    "query": {"type": "string", "minLength": 1, "maxLength": 8000},
    "embedding_profile": {"type": "object"},
    "embedding_profile_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vector_space": {"type": "object"},
    "workspace_corpus_generation_id": {"type": "string", "format": "uuid"},
    "candidate_k": {"type": "integer", "minimum": 1, "maximum": 100},
    "sparse_embedding_profile": {"type": ["object", "null"]},
    "sparse_profile_fingerprint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "sparse_vector_space": {"type": ["object", "null"]},
    "hybrid_configuration": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["version", "dense_candidate_k", "sparse_candidate_k", "fusion_candidate_k", "reranker_candidate_k", "final_evidence_k", "fusion_strategy", "fusion_version", "rrf_k"],
      "properties": {
        "version": {"type": "string", "minLength": 1, "maxLength": 255},
        "dense_candidate_k": {"type": "integer", "minimum": 1, "maximum": 100},
        "sparse_candidate_k": {"type": "integer", "minimum": 1, "maximum": 100},
        "fusion_candidate_k": {"type": "integer", "minimum": 1, "maximum": 100},
        "reranker_candidate_k": {"type": "integer", "minimum": 1, "maximum": 100},
        "final_evidence_k": {"type": "integer", "minimum": 1, "maximum": 100},
        "fusion_strategy": {"const": "rrf"},
        "fusion_version": {"const": "1"},
        "rrf_k": {"type": "integer", "minimum": 1}
      }
    },
    "capture_diagnostics": {"type": "boolean", "default": false},
    "scopes": {
      "type": "array", "minItems": 1, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["side", "eligible_document_ids"],
        "properties": {
          "side": {"enum": ["primary", "comparison"]},
          "eligible_document_ids": {
            "type": "array", "minItems": 1, "maxItems": 500,
            "uniqueItems": true, "items": {"type": "string", "format": "uuid"}
          }
        }
      }
    }
  }
}

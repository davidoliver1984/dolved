{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maketime.ai/contracts/http/retrieval-call/rc1/corpus-rebuild-batch-v1.schema.json",
  "title": "Hybrid corpus rebuild batch request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "workspace_id", "rebuild_event_id", "embedding_profile", "sparse_embedding_profile", "vector_space", "workspace_corpus_generation_id", "chunks"],
  "properties": {
    "contract_version": { "const": 1 },
    "request_id": { "type": "string", "format": "uuid" },
    "workspace_id": { "type": "string", "format": "uuid" },
    "rebuild_event_id": { "type": "string", "format": "uuid" },
    "workspace_corpus_generation_id": { "type": "string", "format": "uuid" },
    "embedding_profile": { "type": "object" },
    "sparse_embedding_profile": { "type": "object" },
    "vector_space": { "type": "object" },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chunk_id", "document_id", "text"],
        "properties": {
          "chunk_id": { "type": "string", "format": "uuid" },
          "document_id": { "type": "string", "format": "uuid" },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maketime.ai/contracts/http/retrieval-call/rc1/generation-answer-v1.schema.json",
  "title": "Provider-neutral grounded generation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "workspace_id", "question", "evidence", "constraints"],
  "properties": {
    "contract_version": {"const": 1},
    "request_id": {"type": "string", "format": "uuid"},
    "workspace_id": {"type": "string", "format": "uuid"},
    "question": {"type": "string", "minLength": 1, "maxLength": 8000},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "text", "document_chunk_id", "document_id", "ingestion_event_claim_id", "source_provenance", "temporal_authority", "applicability_context", "side"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^ev-[0-9]{2,}$"},
          "text": {"type": "string", "minLength": 1},
          "document_chunk_id": {"type": "integer", "minimum": 1},
          "document_id": {"type": "integer", "minimum": 1},
          "ingestion_event_claim_id": {"type": "integer", "minimum": 1},
          "source_provenance": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "object"}
          },
          "temporal_authority": {"type": "object"},
          "applicability_context": {"type": "object"},
          "side": {"enum": ["primary", "comparison"]}
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_policy_version", "max_context_characters", "required_sides", "requested_evidence_type"],
      "properties": {
        "context_policy_version": {"type": "string", "minLength": 1, "maxLength": 255},
        "max_context_characters": {"type": "integer", "minimum": 1},
        "requested_evidence_type": {"enum": ["policy_or_procedural_requirements", "personal_record_status", "current_versus_historical_comparison"]},
        "required_sides": {
          "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
          "items": {"enum": ["primary", "comparison"]}
        }
      }
    }
  }
}

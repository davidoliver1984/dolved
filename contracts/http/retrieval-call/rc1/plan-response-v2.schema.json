{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maketime.ai/contracts/http/retrieval-call/rc1/plan-response-v2.schema.json",
  "title": "Retrieval Plan Response V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "plan", "classifier_lineage", "usage"],
  "properties": {
    "contract_version": { "const": 2 },
    "request_id": { "type": "string", "format": "uuid" },
    "plan": { "$ref": "#/$defs/retrieval_plan" },
    "classifier_lineage": { "$ref": "#/$defs/classifier_lineage" },
    "usage": { "$ref": "#/$defs/planner_usage" }
  },
  "$defs": {
    "temporal_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "enum": ["calendar_period", "historical_reference"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    },
    "retrieval_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrieval_queries", "temporal_mode", "explicit_date", "temporal_reference", "version_transition_boundary", "fact_date", "requested_evidence_type", "location_references", "clarification_reason"],
      "properties": {
        "retrieval_queries": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 8000 }
        },
        "temporal_mode": { "enum": ["current", "compare", "valid_at_date", "historical_reference", "clarification_required"] },
        "explicit_date": { "type": ["string", "null"], "format": "date" },
        "temporal_reference": { "anyOf": [{ "$ref": "#/$defs/temporal_reference" }, { "type": "null" }] },
        "version_transition_boundary": { "anyOf": [{ "$ref": "#/$defs/temporal_reference" }, { "type": "null" }] },
        "fact_date": { "type": ["string", "null"], "minLength": 1, "maxLength": 255 },
        "requested_evidence_type": { "enum": ["policy_or_procedural_requirements", "personal_record_status", "current_versus_historical_comparison"] },
        "location_references": {
          "type": "array", "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 255 }
        },
        "clarification_reason": { "enum": ["unclassifiable_temporal_intent", null] }
      },
      "allOf": [
        { "if": { "properties": { "temporal_mode": { "const": "current" } } }, "then": { "properties": { "explicit_date": { "type": "null" }, "temporal_reference": { "type": "null" }, "clarification_reason": { "type": "null" } } } },
        { "if": { "properties": { "temporal_mode": { "const": "valid_at_date" } } }, "then": { "oneOf": [
          { "properties": { "explicit_date": { "type": "string", "format": "date" }, "temporal_reference": { "type": "null" }, "clarification_reason": { "type": "null" } } },
          { "properties": { "explicit_date": { "type": "null" }, "temporal_reference": { "allOf": [{ "$ref": "#/$defs/temporal_reference" }, { "properties": { "kind": { "const": "calendar_period" } } }] }, "clarification_reason": { "type": "null" } } }
        ] } },
        { "if": { "properties": { "temporal_mode": { "const": "historical_reference" } } }, "then": { "properties": { "explicit_date": { "type": "null" }, "temporal_reference": { "allOf": [{ "$ref": "#/$defs/temporal_reference" }, { "properties": { "kind": { "const": "historical_reference" } } }] }, "clarification_reason": { "type": "null" } } } },
        { "if": { "properties": { "temporal_mode": { "const": "compare" } } }, "then": { "properties": { "clarification_reason": { "type": "null" } }, "not": { "properties": { "explicit_date": { "type": "string" }, "temporal_reference": { "$ref": "#/$defs/temporal_reference" } }, "required": ["explicit_date", "temporal_reference"] } } },
        { "if": { "properties": { "temporal_mode": { "const": "clarification_required" } } }, "then": { "properties": { "explicit_date": { "type": "null" }, "temporal_reference": { "type": "null" }, "clarification_reason": { "const": "unclassifiable_temporal_intent" } } } }
      ]
    },
    "classifier_lineage": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model", "contract_schema_version", "prompt_version", "adapter_version", "fingerprint"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "contract_schema_version": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "planner_usage": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "provider", "model", "execution", "request_count", "retry_count", "input_tokens", "cached_input_tokens", "output_tokens", "latency_ms", "cost_basis", "cost_usd", "pricing_snapshot"],
      "properties": {
        "stage": { "const": "planner" },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "execution": { "enum": ["provider_api", "local"] },
        "request_count": { "type": "integer", "minimum": 0 },
        "retry_count": { "type": "integer", "minimum": 0 },
        "provider_attempt_count": { "type": ["integer", "null"], "minimum": 1 },
        "provider_retry_count": { "type": ["integer", "null"], "minimum": 0 },
        "outer_attempt_count": { "type": ["integer", "null"], "minimum": 1 },
        "outer_retry_count": { "type": ["integer", "null"], "minimum": 0 },
        "rate_limit_event_count": { "type": ["integer", "null"], "minimum": 0 },
        "retry_delays": { "type": "array", "items": { "$ref": "#/$defs/provider_retry_delay" } },
        "first_provider_attempt_at": { "type": ["string", "null"], "format": "date-time" },
        "final_provider_success_at": { "type": ["string", "null"], "format": "date-time" },
        "provider_retry_elapsed_ms": { "type": ["number", "null"], "minimum": 0 },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "latency_ms": { "type": "number", "minimum": 0 },
        "cost_basis": { "enum": ["provider_reported", "estimated", "unavailable", "zero_cost_local"] },
        "cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "pricing_snapshot": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "cost_basis": { "const": "unavailable" } } },
          "then": { "properties": { "cost_usd": { "type": "null" } } }
        },
        {
          "if": { "properties": { "cost_basis": { "const": "zero_cost_local" } } },
          "then": {
            "properties": {
              "execution": { "const": "local" },
              "cost_usd": { "const": 0 }
            }
          }
        },
        {
          "if": { "properties": { "cost_basis": { "const": "estimated" } } },
          "then": {
            "properties": {
              "cost_usd": { "type": "number", "minimum": 0 },
              "pricing_snapshot": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": { "properties": { "cost_basis": { "const": "provider_reported" } } },
          "then": { "properties": { "cost_usd": { "type": "number", "minimum": 0 } } }
        }
      ]
    },
    "provider_retry_delay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delay_seconds", "source"],
      "properties": {
        "delay_seconds": { "type": "number", "minimum": 0 },
        "source": {
          "enum": [
            "retry_after_numeric",
            "retry_after_http_date",
            "ratelimit_reset",
            "x_ratelimit_reset_requests",
            "x_ratelimit_reset_tokens",
            "configured_fallback",
            "shared_cooldown"
          ]
        }
      }
    }
  }
}

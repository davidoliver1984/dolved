{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.rag-platform.internal/events/document-deletion-requested/v1.schema.json",
  "title": "Document Deletion Requested (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "event_version", "occurred_at", "workspace_id", "document_id", "correlation_id", "vector_scopes"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "document.deletion.requested"},
    "event_version": {"const": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "workspace_id": {"type": "string", "format": "uuid"},
    "document_id": {"type": "string", "format": "uuid"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "vector_scopes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vector_space", "workspace_id", "workspace_corpus_generation_id", "document_id"],
        "properties": {
          "vector_space": {
            "type": "object",
            "additionalProperties": false,
            "required": ["collection_name", "embedding_space_generation_id", "profile_fingerprint", "vector_name", "dimensions", "distance", "sparse"],
            "properties": {
              "collection_name": {"type": "string", "minLength": 1},
              "embedding_space_generation_id": {"type": "string", "format": "uuid"},
              "profile_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "vector_name": {"type": "string", "minLength": 1},
              "dimensions": {"type": "integer", "minimum": 1},
              "distance": {"const": "cosine"},
              "sparse": {
                "oneOf": [
                  {"type": "null"},
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["sparse_space_generation_id", "profile_fingerprint", "vector_name"],
                    "properties": {
                      "sparse_space_generation_id": {"type": "string", "format": "uuid"},
                      "profile_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                      "vector_name": {"type": "string", "minLength": 1}
                    }
                  }
                ]
              }
            }
          },
          "workspace_id": {"type": "string", "format": "uuid"},
          "workspace_corpus_generation_id": {"type": "string", "format": "uuid"},
          "document_id": {"type": "string", "format": "uuid"}
        }
      }
    }
  }
}

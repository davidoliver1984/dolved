{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maketime.ai/contracts/evaluation/v2/document-catalog.schema.json",
  "title": "Engineering evaluation document catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "catalog_version", "families"],
  "properties": {
    "schema_version": {"const": "v2"},
    "benchmark_id": {"const": "dolved-care-engineering"},
    "catalog_version": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/family"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9._:-]+$"
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target_family_id", "notes"],
      "properties": {
        "type": {"enum": ["NEAR_DUPLICATE", "CONFLICTS_WITH", "COMPLEMENTS", "IMPLEMENTS"]},
        "target_family_id": {"$ref": "#/$defs/identifier"},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "location_ids"],
      "properties": {
        "kind": {"enum": ["UNIVERSAL", "LOCATIONS"]},
        "location_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "UNIVERSAL"}}},
          "then": {"properties": {"location_ids": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"kind": {"const": "LOCATIONS"}}},
          "then": {"properties": {"location_ids": {"minItems": 1}}}
        }
      ]
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_id",
        "version_number",
        "source_path",
        "governance_state",
        "created_at",
        "approved_at",
        "effective_from",
        "withdrawn_at",
        "supersedes_version_id",
        "applicability",
        "pilot"
      ],
      "properties": {
        "version_id": {"$ref": "#/$defs/identifier"},
        "version_number": {"type": "string", "minLength": 1},
        "source_path": {"type": ["string", "null"]},
        "governance_state": {"enum": ["DRAFT", "APPROVED", "WITHDRAWN"]},
        "created_at": {"type": "string", "format": "date-time"},
        "approved_at": {"type": ["string", "null"], "format": "date-time"},
        "effective_from": {"type": "string", "format": "date-time"},
        "withdrawn_at": {"type": ["string", "null"], "format": "date-time"},
        "supersedes_version_id": {
          "anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]
        },
        "applicability": {"$ref": "#/$defs/applicability"},
        "pilot": {"type": "boolean"}
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "domain",
        "title",
        "document_type",
        "planned_phenomena",
        "relationships",
        "versions"
      ],
      "properties": {
        "family_id": {"$ref": "#/$defs/identifier"},
        "domain": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1},
        "document_type": {"enum": ["POLICY", "PROCEDURE", "FORM", "REFERENCE_TABLE"]},
        "planned_phenomena": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
        "versions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/version"}}
      }
    }
  }
}

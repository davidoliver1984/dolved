{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maketime.ai/contracts/evaluation/v3/benchmark-case.schema.json",
  "title": "Benchmark V3 authored semantic case",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "authoring_status", "cluster_id", "cluster_rationale", "leakage_group_ids", "domain", "variants", "slices", "evaluation_facets", "source_lineage", "planner_expectation", "eligibility_expectation", "retrieval_expectation", "outcome_expectation", "threshold_observability"],
  "properties": {
    "case_id": {"$ref": "#/$defs/identifier"},
    "authoring_status": {"enum": ["DRAFT", "READY_FOR_REVIEW", "REVIEWED"]},
    "cluster_id": {"$ref": "#/$defs/identifier"},
    "cluster_rationale": {"type": "string", "minLength": 1},
    "leakage_group_ids": {"$ref": "#/$defs/identifiers"},
    "domain": {"$ref": "benchmark-taxonomy.schema.json#/$defs/domain_id"},
    "variants": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"$ref": "#/$defs/variant"}},
    "slices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "benchmark-taxonomy.schema.json#/$defs/intrinsic_slice_id"}},
    "evaluation_facets": {"type": "array", "uniqueItems": true, "items": {"$ref": "benchmark-taxonomy.schema.json#/$defs/evaluation_facet_id"}},
    "source_lineage": {"type": "array", "items": {"$ref": "#/$defs/source_reference"}},
    "planner_expectation": {"$ref": "#/$defs/planner_expectation"},
    "eligibility_expectation": {"$ref": "#/$defs/eligibility_expectation"},
    "retrieval_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_units"],
      "properties": {"evidence_units": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}}
    },
    "outcome_expectation": {"$ref": "#/$defs/outcome_expectation"},
    "threshold_observability": {"$ref": "#/$defs/threshold_observability"}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-zA-Z0-9._:-]+$"},
    "identifiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant_id", "question", "evaluation_facets"],
      "properties": {
        "variant_id": {"$ref": "#/$defs/identifier"},
        "question": {"type": "string", "minLength": 1, "maxLength": 4000},
        "evaluation_facets": {"type": "array", "uniqueItems": true, "items": {"$ref": "benchmark-taxonomy.schema.json#/$defs/evaluation_facet_id"}},
        "planner_expectation_override": {"$ref": "#/$defs/planner_expectation_override"}
      }
    },
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_family_id", "document_version_id", "source_path", "source_sha256", "purpose"],
      "properties": {
        "document_family_id": {"$ref": "#/$defs/identifier"},
        "document_version_id": {"$ref": "#/$defs/identifier"},
        "source_path": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "purpose": {"enum": ["EXPECTED_EVIDENCE", "ELIGIBILITY_CONTEXT", "CONTROLLED_REJECTION", "ADVERSARIAL_NEGATIVE"]}
      }
    },
    "temporal_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["calendar_period", "historical_reference"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 255}
      }
    },
    "planner_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temporal_mode", "explicit_date", "temporal_reference", "location_references", "clarification_reason", "expected_outcome"],
      "properties": {
        "temporal_mode": {"enum": ["CURRENT", "COMPARE", "VALID_AT_DATE", "HISTORICAL_REFERENCE", "CLARIFICATION_REQUIRED"]},
        "explicit_date": {"type": ["string", "null"], "format": "date"},
        "temporal_reference": {"anyOf": [{"$ref": "#/$defs/temporal_reference"}, {"type": "null"}]},
        "location_references": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 255}},
        "clarification_reason": {"enum": ["UNCLASSIFIABLE_TEMPORAL_INTENT", null]},
        "expected_outcome": {"enum": ["PLAN_READY", "CLARIFICATION_REQUIRED"]}
      },
      "allOf": [
        {"if": {"properties": {"temporal_mode": {"const": "CURRENT"}}}, "then": {"properties": {"explicit_date": {"type": "null"}, "temporal_reference": {"type": "null"}, "clarification_reason": {"type": "null"}}}},
        {"if": {"properties": {"temporal_mode": {"const": "VALID_AT_DATE"}}}, "then": {"oneOf": [
          {"properties": {"explicit_date": {"type": "string", "format": "date"}, "temporal_reference": {"type": "null"}, "clarification_reason": {"type": "null"}}},
          {"properties": {"explicit_date": {"type": "null"}, "temporal_reference": {"allOf": [{"$ref": "#/$defs/temporal_reference"}, {"properties": {"kind": {"const": "calendar_period"}}}]}, "clarification_reason": {"type": "null"}}}
        ]}},
        {"if": {"properties": {"temporal_mode": {"const": "HISTORICAL_REFERENCE"}}}, "then": {"properties": {"explicit_date": {"type": "null"}, "temporal_reference": {"allOf": [{"$ref": "#/$defs/temporal_reference"}, {"properties": {"kind": {"const": "historical_reference"}}}]}, "clarification_reason": {"type": "null"}}}},
        {"if": {"properties": {"temporal_mode": {"const": "COMPARE"}}}, "then": {"properties": {"clarification_reason": {"type": "null"}}, "not": {"properties": {"explicit_date": {"type": "string"}, "temporal_reference": {"$ref": "#/$defs/temporal_reference"}}, "required": ["explicit_date", "temporal_reference"]}}},
        {"if": {"properties": {"temporal_mode": {"const": "CLARIFICATION_REQUIRED"}}}, "then": {"properties": {"explicit_date": {"type": "null"}, "temporal_reference": {"type": "null"}, "clarification_reason": {"const": "UNCLASSIFIABLE_TEMPORAL_INTENT"}, "expected_outcome": {"const": "CLARIFICATION_REQUIRED"}}}}
      ]
    },
    "planner_expectation_override": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "temporal_mode": {"enum": ["CURRENT", "COMPARE", "VALID_AT_DATE", "HISTORICAL_REFERENCE", "CLARIFICATION_REQUIRED"]},
        "explicit_date": {"type": ["string", "null"], "format": "date"},
        "temporal_reference": {"anyOf": [{"$ref": "#/$defs/temporal_reference"}, {"type": "null"}]},
        "location_references": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 255}}
      }
    },
    "applicability_match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "governing_location_id", "requested_location_id"],
      "properties": {
        "kind": {"enum": ["UNIVERSAL", "DIRECT", "ANCESTOR"]},
        "governing_location_id": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "requested_location_id": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]}
      }
    },
    "eligible_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_family_id", "document_version_id", "side", "applicability"],
      "properties": {
        "document_family_id": {"$ref": "#/$defs/identifier"},
        "document_version_id": {"$ref": "#/$defs/identifier"},
        "side": {"enum": ["PRIMARY", "COMPARISON"]},
        "applicability": {"$ref": "#/$defs/applicability_match"}
      }
    },
    "excluded_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_family_id", "document_version_id", "reason"],
      "properties": {
        "document_family_id": {"$ref": "#/$defs/identifier"},
        "document_version_id": {"$ref": "#/$defs/identifier"},
        "reason": {"enum": ["HISTORICAL_FOR_CURRENT", "SCHEDULED_FUTURE", "WITHDRAWN", "NEVER_ATTAINED_AUTHORITY", "OUTSIDE_REQUESTED_TEMPORAL_SCOPE", "NOT_YET_ATTAINED_AUTHORITY", "APPLICABILITY_MISMATCH", "IRRELEVANT_NEGATIVE"]}
      }
    },
    "eligibility_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_versions", "excluded_versions", "expected_outcome"],
      "properties": {
        "eligible_versions": {"type": "array", "items": {"$ref": "#/$defs/eligible_version"}},
        "excluded_versions": {"type": "array", "items": {"$ref": "#/$defs/excluded_version"}},
        "expected_outcome": {"enum": ["ELIGIBLE_SCOPE_READY", "NO_ELIGIBLE_EVIDENCE", "COMPARISON_SCOPE_INCOMPLETE", "TEMPORAL_SCOPE_UNRESOLVED", "NOT_APPLICABLE"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "document_family_id", "document_version_id", "side", "source_path", "canonical_excerpts", "relevance_grade", "minimum_token_coverage"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/identifier"},
        "document_family_id": {"$ref": "#/$defs/identifier"},
        "document_version_id": {"$ref": "#/$defs/identifier"},
        "side": {"enum": ["PRIMARY", "COMPARISON"]},
        "source_path": {"type": "string", "minLength": 1},
        "canonical_excerpts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "relevance_grade": {"type": "integer", "minimum": 1, "maximum": 2},
        "minimum_token_coverage": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "locator": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "outcome_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "controlled_rejection_rationale"],
      "properties": {
        "outcome": {"enum": ["EVIDENCE_FOUND", "INSUFFICIENT_EVIDENCE", "CLARIFICATION_REQUIRED", "NO_ELIGIBLE_EVIDENCE", "NO_RETRIEVAL_CANDIDATES", "COMPARISON_SCOPE_INCOMPLETE", "TEMPORAL_SCOPE_UNRESOLVED"]},
        "controlled_rejection_rationale": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"outcome": {"const": "EVIDENCE_FOUND"}}}, "then": {"properties": {"controlled_rejection_rationale": {"type": "null"}}}},
        {"if": {"not": {"properties": {"outcome": {"const": "EVIDENCE_FOUND"}}, "required": ["outcome"]}}, "then": {"properties": {"controlled_rejection_rationale": {"type": "string", "minLength": 1}}}}
      ]
    },
    "threshold_observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "reranker_evaluable", "required_sides", "justification"],
      "properties": {
        "classification": {"enum": ["POSITIVE_EVIDENCE", "THRESHOLD_SENSITIVE", "ACCEPTANCE_ONLY"]},
        "reranker_evaluable": {"type": "boolean"},
        "required_sides": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["PRIMARY", "COMPARISON"]}},
        "justification": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"classification": {"const": "THRESHOLD_SENSITIVE"}}}, "then": {"properties": {"reranker_evaluable": {"const": true}}}},
        {"if": {"properties": {"classification": {"const": "ACCEPTANCE_ONLY"}}}, "then": {"properties": {"reranker_evaluable": {"const": false}}}}
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maketime.ai/contracts/evaluation/v3/corpus.schema.json",
  "title": "Benchmark V3 layered evaluation corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "corpus_version", "title", "evaluation_clock", "matching_algorithm", "taxonomy", "cases"],
  "properties": {
    "schema_version": {"const": "v3"},
    "benchmark_id": {"const": "dolved-care-engineering"},
    "corpus_version": {"const": "3"},
    "title": {"type": "string", "minLength": 1},
    "evaluation_clock": {"type": "string", "format": "date-time"},
    "matching_algorithm": {"const": "normalised-token-coverage-v1"},
    "taxonomy": {"$ref": "benchmark-taxonomy.schema.json#/$defs/taxonomy_reference"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "benchmark-case.schema.json"}}
  }
}

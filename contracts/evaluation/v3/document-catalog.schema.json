{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maketime.ai/contracts/evaluation/v3/document-catalog.schema.json",
  "title": "Benchmark V3 document catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "catalog_version", "taxonomy", "families"],
  "properties": {
    "schema_version": {"const": "v3"},
    "benchmark_id": {"const": "dolved-care-engineering"},
    "catalog_version": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "taxonomy": {"$ref": "benchmark-taxonomy.schema.json#/$defs/taxonomy_reference"},
    "families": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/family"}}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-zA-Z0-9._:-]+$"},
    "identifiers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship_id", "type", "target_family_id", "target_version_id", "notes"],
      "properties": {
        "relationship_id": {"$ref": "#/$defs/identifier"},
        "type": {"enum": ["NEAR_DUPLICATE", "CONFLICTS_WITH", "COMPLEMENTS", "IMPLEMENTS"]},
        "target_family_id": {"$ref": "#/$defs/identifier"},
        "target_version_id": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "location_ids"],
      "properties": {
        "kind": {"enum": ["UNIVERSAL", "LOCATIONS"]},
        "location_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "UNIVERSAL"}}}, "then": {"properties": {"location_ids": {"maxItems": 0}}}},
        {"if": {"properties": {"kind": {"const": "LOCATIONS"}}}, "then": {"properties": {"location_ids": {"minItems": 1}}}}
      ]
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version_id", "version_number", "source_path", "source_sha256", "governance_state", "created_at", "approved_at", "effective_from", "withdrawn_at", "supersedes_version_id", "applicability", "evaluation_facets", "leakage_group_ids"],
      "properties": {
        "version_id": {"$ref": "#/$defs/identifier"},
        "version_number": {"type": "string", "minLength": 1},
        "source_path": {"type": ["string", "null"]},
        "source_sha256": {"anyOf": [{"type": "string", "pattern": "^[a-f0-9]{64}$"}, {"type": "null"}]},
        "governance_state": {"enum": ["DRAFT", "APPROVED", "WITHDRAWN"]},
        "created_at": {"type": "string", "format": "date-time"},
        "approved_at": {"type": ["string", "null"], "format": "date-time"},
        "effective_from": {"type": "string", "format": "date-time"},
        "withdrawn_at": {"type": ["string", "null"], "format": "date-time"},
        "supersedes_version_id": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "applicability": {"$ref": "#/$defs/applicability"},
        "evaluation_facets": {"type": "array", "uniqueItems": true, "items": {"$ref": "benchmark-taxonomy.schema.json#/$defs/evaluation_facet_id"}},
        "leakage_group_ids": {"$ref": "#/$defs/identifiers"}
      },
      "allOf": [
        {"if": {"properties": {"source_path": {"type": "string"}}}, "then": {"properties": {"source_sha256": {"type": "string"}}}},
        {"if": {"properties": {"source_path": {"type": "null"}}}, "then": {"properties": {"source_sha256": {"type": "null"}}}}
      ]
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "domain", "title", "document_type", "planned_phenomena", "relationships", "leakage_group_ids", "versions"],
      "properties": {
        "family_id": {"$ref": "#/$defs/identifier"},
        "domain": {"$ref": "benchmark-taxonomy.schema.json#/$defs/domain_id"},
        "title": {"type": "string", "minLength": 1},
        "document_type": {"enum": ["POLICY", "PROCEDURE", "FORM", "REFERENCE_TABLE"]},
        "planned_phenomena": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "benchmark-taxonomy.schema.json#/$defs/evaluation_facet_id"}},
        "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
        "leakage_group_ids": {"$ref": "#/$defs/identifiers"},
        "versions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/version"}}
      }
    }
  }
}

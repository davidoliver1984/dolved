{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maketime.ai/contracts/evaluation/v3/split.schema.json",
  "title": "Benchmark V3 split manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "corpus_version", "split_version", "assignment_status", "taxonomy", "allocation_method", "allocation_method_version", "case_ids_digest", "targets", "assignments", "rules"],
  "properties": {
    "schema_version": {"const": "v3"},
    "benchmark_id": {"const": "dolved-care-engineering"},
    "corpus_version": {"const": "3"},
    "split_version": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "assignment_status": {"enum": ["DRAFT", "COMPLETE", "SEALED"]},
    "taxonomy": {"$ref": "benchmark-taxonomy.schema.json#/$defs/taxonomy_reference"},
    "allocation_method": {"type": "string", "minLength": 1},
    "allocation_method_version": {"type": "string", "minLength": 1},
    "case_ids_digest": {"$ref": "#/$defs/sha256"},
    "targets": {"$ref": "#/$defs/split_counts"},
    "assignments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineering_tuning", "threshold_calibration", "sealed_held_out", "unassigned"],
      "properties": {
        "engineering_tuning": {"$ref": "#/$defs/identifiers"},
        "threshold_calibration": {"$ref": "#/$defs/identifiers"},
        "sealed_held_out": {"$ref": "#/$defs/identifiers"},
        "unassigned": {"$ref": "#/$defs/identifiers"}
      }
    },
    "rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-zA-Z0-9._:-]+$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "identifiers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "split_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineering_tuning", "threshold_calibration", "sealed_held_out"],
      "properties": {
        "engineering_tuning": {"type": "integer", "minimum": 1},
        "threshold_calibration": {"type": "integer", "minimum": 1},
        "sealed_held_out": {"type": "integer", "minimum": 1}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maketime.ai/contracts/evaluation/v3/benchmark-authoring-review.schema.json",
  "title": "Benchmark V3 authoring review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "review_version", "benchmark_id", "corpus_version", "taxonomy", "reviewed_case_ids_digest", "reviewed_source_catalog_digest", "reviewed_at", "machine_validation", "human_review"],
  "properties": {
    "schema_version": {"const": "v3"},
    "review_id": {"$ref": "#/$defs/identifier"},
    "review_version": {"type": "string", "minLength": 1},
    "benchmark_id": {"const": "dolved-care-engineering"},
    "corpus_version": {"const": "3"},
    "taxonomy": {"$ref": "benchmark-taxonomy.schema.json#/$defs/taxonomy_reference"},
    "reviewed_case_ids_digest": {"$ref": "#/$defs/sha256"},
    "reviewed_source_catalog_digest": {"$ref": "#/$defs/sha256"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "machine_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validator_id", "validator_version", "passed"],
      "properties": {
        "validator_id": {"$ref": "#/$defs/identifier"},
        "validator_version": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"}
      }
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_quality_reviewed", "representative_coverage_reviewed", "author_rationale_reviewed", "governance_reviewed", "specialised_reviews"],
      "properties": {
        "semantic_quality_reviewed": {"type": "boolean"},
        "representative_coverage_reviewed": {"type": "boolean"},
        "author_rationale_reviewed": {"type": "boolean"},
        "governance_reviewed": {"type": "boolean"},
        "specialised_reviews": {
          "type": "object",
          "additionalProperties": false,
          "required": ["temporal", "applicability", "adversarial", "threshold_sensitive"],
          "properties": {
            "temporal": {"type": "boolean"},
            "applicability": {"type": "boolean"},
            "adversarial": {"type": "boolean"},
            "threshold_sensitive": {"type": "boolean"}
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-zA-Z0-9._:-]+$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maketime.ai/contracts/evaluation/v3/benchmark-taxonomy.schema.json",
  "title": "Dolved care engineering benchmark taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "taxonomy_id", "taxonomy_version", "status", "domains", "intrinsic_slices", "evaluation_facets", "deprecation_policy"],
  "properties": {
    "schema_version": {"const": "v3"},
    "taxonomy_id": {"const": "dolved-care-engineering-taxonomy"},
    "taxonomy_version": {"const": "1"},
    "status": {"enum": ["DRAFT", "ACTIVE", "SUPERSEDED"]},
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/domain"}
    },
    "intrinsic_slices": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/intrinsic_slice"}
    },
    "evaluation_facets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evaluation_facet"}
    },
    "deprecation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifiers_are_immutable", "deprecated_entries_remain_declared", "replacement_is_explicit", "removal_requires_new_contract_major", "matching"],
      "properties": {
        "identifiers_are_immutable": {"const": true},
        "deprecated_entries_remain_declared": {"const": true},
        "replacement_is_explicit": {"const": true},
        "removal_requires_new_contract_major": {"const": true},
        "matching": {"const": "EXACT_IDENTIFIER_ONLY"}
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9._:-]+$"
    },
    "domain_id": {
      "enum": ["complaints", "fire-safety", "gdpr", "health-safety", "hr", "infection-control", "medication", "payroll", "reference", "safeguarding", "training", "visitors"]
    },
    "intrinsic_slice_id": {
      "enum": ["COMPARE", "CURRENT", "VALID_AT_DATE", "adversarial", "applicability", "applicability-context", "historical", "location-alias", "multi-document", "multi-evidence", "never-authoritative", "predecessor-resurrection", "region-specific", "regional-applicability", "scheduled-future", "site-specific", "temporal-authority", "withdrawn", "zero-evidence"]
    },
    "evaluation_facet_id": {
      "enum": [
        "abbreviation", "after-authority-transition", "alias-colloquial", "alias-formal", "ambiguous-location", "applicability-excluded", "before-authority-transition", "changed-instruction", "changed-structured-value", "clarification-required", "colloquial", "compare-comparison-empty", "compare-primary-empty", "conflicting-guidance", "cross-document-completeness", "form-evidence", "historical-explicit", "historical-ordinal", "historical-previous", "keyword-stuffing", "long-form", "near-duplicate", "near-duplicate-wrong", "negative-instruction", "never-authoritative", "no-predecessor-resurrection", "no-trustworthy-candidate", "numeric-boundary", "regional", "scheduled", "site-specific", "table-evidence", "three-plus-evidence-units", "two-evidence-units", "universal", "unresolved-location", "withdrawn"
      ]
    },
    "status": {"enum": ["ACTIVE", "DEPRECATED"]},
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain_id", "label", "description", "status", "replacement_id"],
      "properties": {
        "domain_id": {"$ref": "#/$defs/domain_id"},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "replacement_id": {"anyOf": [{"$ref": "#/$defs/domain_id"}, {"type": "null"}]}
      }
    },
    "intrinsic_slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slice_id", "description", "status", "replacement_id"],
      "properties": {
        "slice_id": {"$ref": "#/$defs/intrinsic_slice_id"},
        "description": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "replacement_id": {"anyOf": [{"$ref": "#/$defs/intrinsic_slice_id"}, {"type": "null"}]}
      }
    },
    "evaluation_facet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facet_id", "category", "description", "permitted_scopes", "status", "replacement_id"],
      "properties": {
        "facet_id": {"$ref": "#/$defs/evaluation_facet_id"},
        "category": {"enum": ["APPLICABILITY_LOCATION", "CONTROLLED_BEHAVIOUR", "RETRIEVAL_STRUCTURE", "ROBUSTNESS", "SOURCE_STRUCTURE", "TEMPORAL_AUTHORITY"]},
        "description": {"type": "string", "minLength": 1},
        "permitted_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["CASE", "VARIANT", "DOCUMENT"]}
        },
        "status": {"$ref": "#/$defs/status"},
        "replacement_id": {"anyOf": [{"$ref": "#/$defs/evaluation_facet_id"}, {"type": "null"}]}
      }
    },
    "taxonomy_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taxonomy_id", "taxonomy_version", "taxonomy_sha256"],
      "properties": {
        "taxonomy_id": {"const": "dolved-care-engineering-taxonomy"},
        "taxonomy_version": {"const": "1"},
        "taxonomy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}

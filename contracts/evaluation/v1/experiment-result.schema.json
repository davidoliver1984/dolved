{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maketime.ai/contracts/evaluation/v1/experiment-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "executed_at", "candidate_k", "lineage", "aggregate", "slices", "variants", "hard_failures", "model_assisted"],
  "properties": {
    "schema_version": {"const": "v1"},
    "experiment_id": {"$ref": "#/$defs/identifier"},
    "executed_at": {"type": "string", "format": "date-time"},
    "candidate_k": {"type": "integer", "minimum": 1},
    "lineage": {"$ref": "#/$defs/lineage"},
    "aggregate": {"$ref": "#/$defs/aggregate"},
    "slices": {"type": "object", "additionalProperties": {"$ref": "#/$defs/aggregate"}},
    "variants": {"type": "array", "items": {"$ref": "#/$defs/variant"}},
    "hard_failures": {"type": "array", "items": {"$ref": "#/$defs/identifier"}},
    "model_assisted": {"type": "array", "items": {"$ref": "#/$defs/model_assisted"}}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-zA-Z0-9._:-]+$"},
    "metric_values": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recall_at_k", "precision_at_k", "mrr", "ndcg_at_k"],
      "properties": {
        "recall_at_k": {"type": "number", "minimum": 0, "maximum": 1},
        "precision_at_k": {"type": "number", "minimum": 0, "maximum": 1},
        "mrr": {"type": "number", "minimum": 0, "maximum": 1},
        "ndcg_at_k": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "planner_accuracy", "eligibility_accuracy", "outcome_accuracy", "case_count"],
      "properties": {
        "metrics": {"$ref": "#/$defs/metric_values"},
        "planner_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "eligibility_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "outcome_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "case_count": {"type": "integer", "minimum": 0}
      }
    },
    "operational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency_ms", "token_usage", "provider_cost", "request_count"],
      "properties": {
        "latency_ms": {"type": "number", "minimum": 0},
        "token_usage": {"type": "integer", "minimum": 0},
        "provider_cost": {"type": "number", "minimum": 0},
        "request_count": {"type": "integer", "minimum": 0}
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "variant_id", "metrics", "side_metrics", "covered_evidence_ids", "planner_correct", "eligibility_correct", "outcome_correct", "hard_failures", "operational"],
      "properties": {
        "case_id": {"$ref": "#/$defs/identifier"},
        "variant_id": {"$ref": "#/$defs/identifier"},
        "metrics": {"$ref": "#/$defs/metric_values"},
        "side_metrics": {"type": "object", "additionalProperties": {"$ref": "#/$defs/metric_values"}},
        "covered_evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}},
        "planner_correct": {"type": "boolean"},
        "eligibility_correct": {"type": "boolean"},
        "outcome_correct": {"type": "boolean"},
        "hard_failures": {"type": "array", "items": {"$ref": "#/$defs/identifier"}},
        "operational": {"$ref": "#/$defs/operational"}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_commit", "corpus_version", "corpus_digest", "policy_version", "policy_digest", "harness_version", "matching_algorithm", "planner", "embedding_profile_fingerprint", "chunking_configuration", "retrieval_configuration", "evaluator", "trial_count"],
      "properties": {
        "repository_commit": {"type": "string", "minLength": 1},
        "corpus_version": {"type": "string", "minLength": 1},
        "corpus_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "policy_version": {"type": "string", "minLength": 1},
        "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "harness_version": {"type": "string", "minLength": 1},
        "matching_algorithm": {"type": "string", "minLength": 1},
        "planner": {"type": "object"},
        "embedding_profile_fingerprint": {"type": "string", "minLength": 1},
        "chunking_configuration": {"type": "object"},
        "retrieval_configuration": {"type": "object"},
        "evaluator": {"type": ["object", "null"]},
        "trial_count": {"type": "integer", "minimum": 1}
      }
    },
    "model_assisted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "variant_id", "status", "scores", "evaluator_identity", "failure_code"],
      "properties": {
        "case_id": {"$ref": "#/$defs/identifier"},
        "variant_id": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["COMPLETED", "FAILED"]},
        "scores": {"type": "object", "additionalProperties": {"type": "number"}},
        "evaluator_identity": {"type": "object"},
        "failure_code": {"type": ["string", "null"]}
      }
    }
  }
}

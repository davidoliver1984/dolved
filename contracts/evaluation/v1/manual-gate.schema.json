{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "decision", "reviewer", "decided_at", "reason", "waiver_expires_at"],
  "properties": {
    "schema_version": {"const": "v1"}, "experiment_id": {"type": "string"},
    "decision": {"enum": ["ACCEPTED", "REJECTED", "WAIVED"]}, "reviewer": {"type": "string"},
    "decided_at": {"type": "string", "format": "date-time"}, "reason": {"type": "string", "minLength": 1},
    "waiver_expires_at": {"type": ["string", "null"], "format": "date-time"}
  }
}

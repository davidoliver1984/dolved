{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maketime.ai/contracts/evaluation/v1/corpus.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_version", "title", "matching_algorithm", "cases"],
  "properties": {
    "schema_version": {"const": "v1"},
    "corpus_version": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "title": {"type": "string", "minLength": 1},
    "matching_algorithm": {"const": "normalised-token-coverage-v1"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-zA-Z0-9._:-]+$"},
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "variants", "slices", "evidence_units"],
      "properties": {
        "case_id": {"$ref": "#/$defs/identifier"},
        "variants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/variant"}},
        "slices": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}},
        "evidence_units": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "expected_temporal_mode": {"type": ["string", "null"]},
        "expected_outcome": {"type": ["string", "null"]}
      }
    },
    "variant": {
      "type": "object", "additionalProperties": false, "required": ["variant_id", "question"],
      "properties": {"variant_id": {"$ref": "#/$defs/identifier"}, "question": {"type": "string", "minLength": 1, "maxLength": 4000}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "document_family_id", "document_version_id", "source_path", "canonical_excerpts"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/identifier"},
        "document_family_id": {"$ref": "#/$defs/identifier"},
        "document_version_id": {"$ref": "#/$defs/identifier"},
        "side": {"enum": ["PRIMARY", "COMPARISON"], "default": "PRIMARY"},
        "source_path": {"type": "string", "minLength": 1},
        "canonical_excerpts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "relevance_grade": {"type": "integer", "minimum": 1, "maximum": 2, "default": 2},
        "minimum_token_coverage": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 1},
        "notes": {"type": ["string", "null"]}
      }
    }
  }
}

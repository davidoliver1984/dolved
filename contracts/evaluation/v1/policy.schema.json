{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maketime.ai/contracts/evaluation/v1/policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "absolute_failures", "load_bearing_slices", "allowed_regressions", "advisory_metrics"],
  "properties": {
    "schema_version": {"const": "v1"},
    "policy_version": {"type": "string", "minLength": 1},
    "absolute_failures": {"type": "array", "items": {"type": "string"}},
    "load_bearing_slices": {"type": "array", "items": {"type": "string"}},
    "allowed_regressions": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "advisory_metrics": {"type": "array", "items": {"type": "string"}}
  }
}

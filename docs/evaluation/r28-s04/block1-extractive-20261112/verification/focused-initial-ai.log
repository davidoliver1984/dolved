        elif fault == "duplicate":
            binding["family_ids"] *= 2
        elif fault in {"ownership_location", "ownership_quote"}:
            binding.update(
                ownership="external_tenant",
                ownership_source=example["plan"]["needs"][0]["question_span"].copy(),

# Copy to the pinned Dify docker directory as .env. Values marked SECURE_STORE_REQUIRED
# must be generated independently and delivered through the server secret store.
COMPOSE_PROFILES=weaviate,postgresql,collaboration

SECRET_KEY=SECURE_STORE_REQUIRED
INIT_PASSWORD=SECURE_STORE_REQUIRED
DB_PASSWORD=SECURE_STORE_REQUIRED
REDIS_PASSWORD=SECURE_STORE_REQUIRED
CODE_EXECUTION_API_KEY=SECURE_STORE_REQUIRED
PLUGIN_DAEMON_KEY=SECURE_STORE_REQUIRED
PLUGIN_DIFY_INNER_API_KEY=SECURE_STORE_REQUIRED
DIFY_AGENT_LOCAL_SANDBOX_AUTH_TOKEN=SECURE_STORE_REQUIRED
DIFY_AGENT_API_TOKEN=SECURE_STORE_REQUIRED
# Exactly 32 random bytes encoded as unpadded base64url.
DIFY_AGENT_SERVER_SECRET_KEY=SECURE_STORE_REQUIRED
WEAVIATE_API_KEY=SECURE_STORE_REQUIRED
WEAVIATE_AUTHENTICATION_ANONYMOUS_ACCESS_ENABLED=false
WEAVIATE_DISABLE_TELEMETRY=true

ALLOW_REGISTER=false
ALLOW_CREATE_WORKSPACE=false
ALLOW_EMBED=false
MARKETPLACE_ENABLED=false
CHECK_UPDATE_URL=
NEXT_TELEMETRY_DISABLED=1

DB_USERNAME=postgres
DB_DATABASE=dify
VECTOR_STORE=weaviate
STORAGE_TYPE=local


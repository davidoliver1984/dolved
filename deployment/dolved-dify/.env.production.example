COMPOSE_PROJECT_NAME=dolved-pilot
DOLVED_DOMAIN=pilot.example.com
API_DOMAIN=api.pilot.example.com
STORAGE_DOMAIN=storage.pilot.example.com
ACME_EMAIL=operations@example.com

APP_NAME=Dolved
APP_ENV=production
APP_DEBUG=false
APP_KEY=SECURE_STORE_REQUIRED
APP_URL=https://api.pilot.example.com
FRONTEND_URL=https://pilot.example.com
NEXT_PUBLIC_API_URL=https://api.pilot.example.com
CORS_ALLOWED_ORIGINS=https://pilot.example.com
SANCTUM_STATEFUL_DOMAINS=pilot.example.com
SESSION_DOMAIN=.pilot.example.com
SESSION_SECURE_COOKIE=true
AUTH_REGISTRATION_ENABLED=false

POSTGRES_DB=dolved
POSTGRES_USER=dolved
POSTGRES_PASSWORD=SECURE_STORE_REQUIRED

AWS_ACCESS_KEY_ID=SECURE_STORE_REQUIRED
AWS_SECRET_ACCESS_KEY=SECURE_STORE_REQUIRED
AWS_DEFAULT_REGION=us-east-1
DOCUMENT_UPLOAD_BUCKET=dolved-originals
BRANDING_WORKSPACE_PUBLIC_ID=
BRANDING_ASSET_DISK=s3

DOCUMENT_PROCESSING_DRIVER=dify
DIFY_BASE_URL=http://dify-nginx
DIFY_APP_API_KEY=SECURE_STORE_REQUIRED
DIFY_KNOWLEDGE_API_KEY=SECURE_STORE_REQUIRED
DIFY_TIMEOUT_SECONDS=180
DIFY_CONNECT_TIMEOUT_SECONDS=10
DIFY_DOCUMENT_SYNC_QUEUE=document-administration

MAIL_MAILER=smtp
MAIL_HOST=SECURE_STORE_REQUIRED
MAIL_PORT=587
MAIL_USERNAME=SECURE_STORE_REQUIRED
MAIL_PASSWORD=SECURE_STORE_REQUIRED
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=SECURE_STORE_REQUIRED
MAIL_FROM_NAME=Dolved
